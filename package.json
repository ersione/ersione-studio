{
  "name": "ersione-studio",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "test:unit": "node --test unit/*.test.mjs",
    "update:images": "UPDATE_ASSETS=1 playwright test tests/assets.spec.js",
    "test:seo": "playwright test --config playwright.seo.config.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.28.2",
    "vite": "^7.1.0"
  }
}
